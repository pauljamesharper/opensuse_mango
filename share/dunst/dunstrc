[global]
    # Display
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = (10, 50)
    width = 500
    height = (0, 300)
    indicate_hidden = yes
    separator_height = 2
    padding = 15
    horizontal_padding = 15
    frame_width = 3
    frame_color = "#d39369"  # THEME: dunst_frame_global
    separator_color = auto
    sort = yes
    idle_threshold = 120

    # Text
    font = RobotoMono Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 30
    word_wrap = yes
    ellipsize = middle
    ignore_newline = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons
    icon_position = left
    min_icon_size = 16
    max_icon_size = 32
    enable_recursive_icon_lookup = true

    # History
    sticky_history = yes
    history_length = 20

    # Advanced
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    corner_radius = 15

    # Progress bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    # Misc
    notification_limit = 5
    ignore_dbusclose = false

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#181c20"  # THEME: dunst_bg_low
    foreground = "#606a76"  # THEME: dunst_fg_low
    frame_color = "#d39369"  # THEME: dunst_frame_low
    timeout = 10
    highlight = "#d6d5a3"  # THEME: dunst_highlight_low

[urgency_normal]
    background = "#181c20"  # THEME: dunst_bg_normal
    foreground = "#d2c3bc"  # THEME: dunst_fg_normal
    frame_color = "#d39369"  # THEME: dunst_frame_normal
    timeout = 10
    highlight = "#d39369"  # THEME: dunst_highlight_normal

[urgency_critical]
    background = "#181c20"  # THEME: dunst_bg_critical
    foreground = "#d2c3bc"  # THEME: dunst_fg_critical
    frame_color = "#cf9a81"  # THEME: dunst_frame_critical
    timeout = 30
    highlight = "#cf9a81"  # THEME: dunst_highlight_critical
