#!/bin/sh
# screen-off — power the outputs down now; the next keypress or mouse move
# brings them back. A one-shot swayidle: one second without input is idle
# (outputs off), the first input after that is resume (outputs on, and
# this swayidle ends). The session's swayidle (scripts/idle) keeps running;
# a bare `wlopm --off` would stay dark until its 15-minute resume.
# shellcheck disable=SC2016  # $PPID must expand in swayidle's own sh -c, not here
exec swayidle -w timeout 1 'wlopm --off \*' resume 'wlopm --on \*; kill $PPID'
