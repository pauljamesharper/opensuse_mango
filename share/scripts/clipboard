#!/bin/sh
# clipboard — open the bar's clipboard history (quickshell/ClipboardPopup.qml).
# rofi only runs when the bar isn't there to answer, so Super+v still
# copies an old entry if quickshell has crashed.
SHARE="$(dirname "$(dirname "$(readlink -f "$0")")")"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/mango"
qs -p "$SHARE/quickshell" ipc call clipboard toggle >/dev/null 2>&1 && exit 0
# the wallpaper palette (state/colors.rasi) is imported on top of the theme
pick=$(cliphist list | rofi -dmenu -i -display-columns 2 -p "Clipboard" \
    -theme "$SHARE/rofi/config.rasi" -theme-str "@import \"$STATE/colors.rasi\"") || exit 0
printf '%s\n' "$pick" | cliphist decode | wl-copy
