#!/bin/bash
# mango-reload — reload config.conf, then have the bar re-apply the gaps
# and the effects (toggles, border width, unfocused opacity).
# reload_config resets every setoption value (inner gaps from the slider,
# outer gaps scaled to the screen) back to what config.conf says.
SHARE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

"$SHARE/scripts/mango-ipc" dispatch reload_config >/dev/null 2>&1 || true
qs -p "$SHARE/quickshell" ipc call wm applyGaps >/dev/null 2>&1 || true
qs -p "$SHARE/quickshell" ipc call wm applyEffects >/dev/null 2>&1 || true
