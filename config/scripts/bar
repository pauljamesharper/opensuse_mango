#!/bin/sh
# bar — quickshell helper. Plain `qs` can't find this config (it lives in
# ~/.config/mango/quickshell, not the default path), so every invocation
# needs -p; this saves typing it.
#   bar start     launch the bar unless it's running (config.conf's exec-once)
#   bar restart   kill + relaunch the bar (default)
#   bar log       tail the instance log
#   bar <args>    any other qs subcommand, e.g. `bar ipc show`
C="$(dirname "$(dirname "$(readlink -f "$0")")")"
P="$C/quickshell"

# The daemon inherits this shell's cwd and passes it to everything it
# spawns; launched from a directory that later gets deleted, every child
# `sh` warns "getcwd() failed". Home outlives any terminal's cwd.
cd "$HOME" || cd /

# quickshell doesn't follow the GTK icon theme on its own (theme icons
# come out missing), so hand it the one nwg-look / gsettings has set;
# the launcher grid and the tray then match GTK apps. A theme change
# takes effect on the next restart (command menu: Restart bar).
icon_theme=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'")
[ -n "$icon_theme" ] && export QS_ICON_THEME="$icon_theme"
# Settings the bar keeps (bar height, gaps, effects, weather location,
# kept monitor layouts...) live in XDG_STATE_HOME, not in the config
# folder, so an update that replaces ~/.config/mango never loses them.
# Files from before that change (they sat in the config folder) are moved
# across the first time; a file already in the state folder wins.
S="${XDG_STATE_HOME:-$HOME/.local/state}/mango"
mkdir -p "$S"
for f in bar-height bar-scale popup-scale tag-icons mango-gaps mango-effects \
         lock-idle lock-style pomodoro weather-location weather-units \
         launcher-history displays.conf; do
    if [ -f "$C/$f" ]; then
        [ -e "$S/$f" ] || mv "$C/$f" "$S/$f"
        rm -f "$C/$f"
    fi
done

case "${1:-restart}" in
    start)   exec qs -p "$P" -d -n ;;
    restart) qs -p "$P" kill 2>/dev/null; sleep 0.5; exec qs -p "$P" -d -n ;;
    log)     exec qs -p "$P" log ;;
    *)       exec qs -p "$P" "$@" ;;
esac
