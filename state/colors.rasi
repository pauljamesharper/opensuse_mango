/* Generated from wallpaper: mangobutter-journey.png */

* {
    bg:          #181c20;
    fg:          #d2c3bc;
    accent:      #d39369;
    accent-2:    #d6d5a3;
    border:      #d39369;
    urgent:      #cf9a81;
